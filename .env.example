SERVER_IP=192.168.10.17
# Password for http://<server>:8085/dashboard (any username). Required, or the admin page is disabled.
ADMIN_PASSWORD=change-me

# Everything below is only the FIRST-RUN default. Change it afterwards from the dashboard
# (saved in data/settings.json, applied to all workstations without restarting anything).

# Must be a local path or a Hugging Face id containing "/" (WhisperLive requirement)
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Ollama is NOT started by docker compose: it uses the one already running on the host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# Odoo on the same Docker host: http://host.docker.internal:8069
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_PROJECT_ID=
